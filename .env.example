# NVIDIA NIM (recommended — free tier at build.nvidia.com)
# Get key: https://build.nvidia.com → sign in → any model → Get API Key
NVIDIA_API_KEY=nvapi-your-key-here
VISION_MODEL=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning
VISION_BASE_URL=https://integrate.api.nvidia.com/v1
VISION_ENABLE_THINKING=false

# Alternative: generic OpenAI-compatible provider
# VISION_API_KEY=...
# VISION_MODEL=gpt-4o
# VISION_BASE_URL=https://api.openai.com/v1

# Legacy OpenAI names still work
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o

# Server
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=*
MAX_UPLOAD_MB=10

# Frontend (optional — leave empty to use Vite proxy in dev)
# VITE_API_BASE=http://100.x.y.z:8000
